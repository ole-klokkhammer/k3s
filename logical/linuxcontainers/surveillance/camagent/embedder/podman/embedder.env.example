# embedder environment - copy to the LXC as /env/surveillance/embedder.env (never in git)

# stills written by the movement detector (read-only mount in the quadlet)
EMBEDDER_POLL_DIR=/media/detector/events
EMBEDDER_STATE_DB=/config/embedder/state.db

# model baked into the image; device shares the 5060 Ti with the detector
EMBEDDER_MODEL=/models/clip-vit-b32
EMBEDDER_DEVICE=cuda:0
EMBEDDER_PORT=8101

# camera this stills dir belongs to (add one embedder per camera later,
# or switch to per-camera subdirs)
EMBEDDER_CAMERA=entrance_roof
EMBEDDER_POLL_SECS=5

# event bus in this LXC
NATS_URL=nats://127.0.0.1:4222
NATS_SUBJECT=surveillance.still

# events + vectors live in the postgres LXC (see ../../sql/schema.sql)
PG_DSN=postgresql://surveillance_user:CHANGE_ME@postgres.home.lan:5432/surveillance
