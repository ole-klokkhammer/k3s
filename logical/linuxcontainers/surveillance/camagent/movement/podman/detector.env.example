# detector environment - copy to the LXC as /config/detector/.env (never in git)

# mediamtx re-served MAIN stream, from the mediamtx LXC (adjust FQDN to your DNS)
DETECTOR_RTSP_URL=rtsp://mediamtx.homelan:8554/entrance_roof

# downscale longest edge to this many px before inference (2560 -> 1280)
DETECTOR_INPUT_SIZE=1280
DETECTOR_CONF=0.5
DETECTOR_DEVICE=cuda:0

# default model baked into the image; override to point at a fine-tuned .pt
# (keep fine-tuned weights in /config/detector/, not in the image)
DETECTOR_MODEL=/models/yolo11m.pt

# event stills land on the HDD pool
DETECTOR_EVENT_DIR=/media/detector/events
DETECTOR_STILL_EVERY=10
DETECTOR_LOG_EVERY=60
