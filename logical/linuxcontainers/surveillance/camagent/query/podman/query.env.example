# query agent environment - copy to the LXC as /env/surveillance/query.env (never in git)

QUERY_PORT=8100

# LLM: OpenAI-compatible endpoint on the 5090 llm LXC (sglang/vllm).
# the server must have tool calling enabled:
#   vllm: --enable-auto-tool-parser / sglang: --tool-call-parser <parser>
QUERY_LLM_BASE_URL=http://llm.home.lan:8000/v1
QUERY_LLM_MODEL=gemma-4-31b-it
# QUERY_LLM_API_KEY=

# events + vectors (see ../../sql/schema.sql)
QUERY_PG_DSN=postgresql://surveillance_user:CHANGE_ME@postgres.home.lan:5432/surveillance

# embedder (same LXC) + mediamtx LXC (playback)
QUERY_EMBED_URL=http://127.0.0.1:8101
QUERY_MEDIAMTX=http://mediamtx.homelan:9996

# optional: live-frame vision via the ai-utils LXC (vllm OpenAI endpoint)
# QUERY_VISION_URL=http://ai-utils.home.lan:8000/v1
# QUERY_VISION_MODEL=Qwen3VL-8B-Instruct-NVFP4

QUERY_MAX_ROUNDS=4
